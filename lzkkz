    local function setAnimId(anim, value)
        if animBackup[anim] == nil then
            animBackup[anim] = anim.AnimationId
        end
        anim.AnimationId = value
    end

    local function restartAnimate(char)
        local animate = char:FindFirstChild("Animate")
        if not animate then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        if animator then
            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                -- so para as animacoes do script Animate (idle/walk/run...). As do jogo,
                -- como a da espada, ficam tocando: parar elas deixava a espada sem pose.
                local okFrom, fromAnimate = pcall(function()
                    local a = track.Animation
                    return a ~= nil and a:IsDescendantOf(animate)
                end)
                if okFrom and fromAnimate then
                    pcall(function() track:Stop(0) end)
                end
            end
        end
        pcall(function() animate.Disabled = true end)
        task.wait()
        pcall(function() animate.Disabled = false end)
    end

    local function restoreAnimations(char)
        for anim, original in pairs(animBackup) do
            pcall(function()
                if anim.Parent then
                    anim.AnimationId = original
                end
            end)
        end
        animBackup = {}
        if char then
            pcall(restartAnimate, char)
        end
    end

    local function applyAnimationsFromPlayer(char, otherPlayer)
        local mine = char:FindFirstChild("Animate")
        local theirChar = otherPlayer.Character
        local theirs = theirChar and theirChar:FindFirstChild("Animate")
        if not mine or not theirs then return 0 end
        local count = 0
        for _, folder in ipairs(theirs:GetChildren()) do
            local myFolder = mine:FindFirstChild(folder.Name)
            if myFolder then
                for _, a in ipairs(folder:GetChildren()) do
                    if a:IsA("Animation") and a.AnimationId ~= "" then
                        local target = myFolder:FindFirstChild(a.Name)
                        if target and target:IsA("Animation") then
                            setAnimId(target, a.AnimationId)
                            count = count + 1
                        end
                    end
                end
            end
        end
        return count
    end

    local function applyAnimationsFromDesc(char, desc)
        local animate = char:FindFirstChild("Animate")
        if not animate then return 0 end
        local count = 0
        for _, slot in ipairs(ANIM_SLOTS) do
            local okId, rawId = pcall(function() return desc[slot.key] end)
            local id = okId and tonumber(rawId) or 0
            local folder = animate:FindFirstChild(slot.folder)
            if folder and id and id > 0 then
                local objs = loadAsset(id)
                local anims = objs and findAll(objs, "Animation") or {}
                if #anims > 0 then
                    for i, name in ipairs(slot.names) do
                        local target = folder:FindFirstChild(name)
                        if target and target:IsA("Animation") then
                            local src
                            for _, a in ipairs(anims) do
                                if a.Name == name then
                                    src = a
                                    break
                                end
                            end
                            src = src or anims[i] or anims[1]
                            setAnimId(target, src.AnimationId)
                            count = count + 1
                        end
                    end
                else
                    local target = folder:FindFirstChild(slot.names[1])
                    if target and target:IsA("Animation") then
                        setAnimId(target, "rbxassetid://" .. fmtId(id))
                        count = count + 1
                    end
                end
                if objs then
                    for _, o in ipairs(objs) do
                        pcall(function() o:Destroy() end)
                    end
                end
            end
        end
        return count
    end

    local function applyCopiedAnimations(char, desc, userId)
        pcall(function() char:WaitForChild("Animate", 3) end)
        restoreAnimations(nil)
        local count = 0
        local other = userId and Players:GetPlayerByUserId(userId)
        if other and other ~= LP then
            local ok, n = pcall(applyAnimationsFromPlayer, char, other)
            if ok and n then count = n end
        end
        if count == 0 then
            local ok, n = pcall(applyAnimationsFromDesc, char, desc)
            if ok and n then count = n end
        end
        if count > 0 then
            pcall(restartAnimate, char)
        end
        return count
    end

    local function collectEmotes(desc)
        local list, seen = {}, {}
        local okAll, all = pcall(function() return desc:GetEmotes() end)
        local okEq, equipped = pcall(function() return desc:GetEquippedEmotes() end)
        if not okAll or type(all) ~= "table" then
            all = {}
        end
        if okEq and type(equipped) == "table" then
            table.sort(equipped, function(a, b)
                return (a.Slot or 0) < (b.Slot or 0)
            end)
            for _, e in ipairs(equipped) do
                local ids = all[e.Name]
                if type(ids) == "table" and ids[1] and not seen[e.Name] then
                    seen[e.Name] = true
                    table.insert(list, { name = e.Name, id = ids[1] })
                end
            end
        end
        local extra = {}
        for name, ids in pairs(all) do
            if not seen[name] and type(ids) == "table" and ids[1] then
                table.insert(extra, { name = name, id = ids[1] })
            end
        end
        table.sort(extra, function(a, b) return a.name < b.name end)
        for _, e in ipairs(extra) do
            table.insert(list, e)
        end
        return list
    end

    local function stopEmote()
        if emoteConn then
            emoteConn:Disconnect()
            emoteConn = nil
        end
        if emoteTrack then
            local track = emoteTrack
            emoteTrack = nil
            pcall(function() track:Stop() end)
            pcall(function() track:Destroy() end)
        end
    end

    local function playEmote(name, id)
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return false end
        stopEmote()
        local animator = hum:FindFirstChildOfClass("Animator") or hum
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. fmtId(id)
        local okLoad, track = pcall(function()
            return animator:LoadAnimation(anim)
        end)
        if okLoad and track then
            local started = os.clock()
            while track.Length == 0 and os.clock() - started < 2 do
                task.wait()
            end
            if track.Length > 0 then
                track.Priority = Enum.AnimationPriority.Action
                track:Play()
                emoteTrack = track
                emoteConn = hum.Running:Connect(function(speed)
                    if speed > 0.5 then
                        stopEmote()
                    end
                end)
                return true
            end
            pcall(function() track:Destroy() end)
        end
        local okEmote, played = pcall(function()
            return hum:PlayEmote(name)
        end)
        return okEmote and played == true
    end

    local function setIdentity(userId, name)
        if not originalIdentity then
            originalIdentity = { userId = LP.UserId, name = LP.Name }
        end
        local okId = pcall(function() LP.UserId = userId end)
        if not okId and type(sethiddenproperty) == "function" then
            pcall(sethiddenproperty, LP, "UserId", userId)
        end
        if name and name ~= "" then
            pcall(function() LP.Name = name end)
