function System.autoparry.process(ball, now)
    local ap = System.autoparry
    local sys = System.__properties
    local char = LocalPlayer.Character
    local root = char and char.PrimaryPart
    if not root or not ball.Parent then return end
    local zoomies = ball:FindFirstChild("zoomies")
    if not zoomies then return end
    local st, vel, speed = ap.track(ball, zoomies, now)
    local vfx = ball:FindFirstChild("AeroDynamicSlashVFX")
    if vfx then
        vfx:Destroy()
        sys.__tornado_time = tick()
    end
    if sys.__parried then return end
    if System.__config.__detections.__pull and System.pull.blocked(ball) then return end
    if ball:GetAttribute("target") ~= LocalPlayer.Name then
        st.fired = false
        return
    end
    if st.fired then
        if now - st.fired_at < 1 then return end
        st.fired = false
    end
    local tornado = Runtime:FindFirstChild("Tornado")
    if tornado and (tick() - sys.__tornado_time) < ((tornado:GetAttribute("TornadoTime") or 1) + 0.314159) then return end
    if ball:FindFirstChild("ComboCounter") then return end
    if root:FindFirstChild("SingularityCape") then return end
    local det = System.__config.__detections
    if det.__infinity and sys.__infinity_active then return end
    if det.__deathslash and sys.__deathslash_active then return end
    if det.__timehole and sys.__timehole_active then return end
    if det.__slashesoffury and sys.__slashesoffury_active then return end
    if not ap.should_fire(ball, st, vel, speed, root) then return end
    if getgenv().AutoAbility and ap.try_ability() then return end
    if ap.fire() then
        st.fired = true
        st.fired_at = now
    end
end

function System.autoparry.on_target(ball, st)
    if System.__properties.__pull_active and ball:GetAttribute("target") ~= LocalPlayer.Name then
        System.__properties.__pull_flipped = true
    end
    st.fired = false
    st.fired_at = 0
    st.omega = 0
    st.accel = 0
    st.settle = 1
    st.t0 = os.clock()
    local z = ball:FindFirstChild("zoomies")
    local v = z and z.VectorVelocity or Vector3.zero
    st.s0 = v.Magnitude
    if st.s0 > 1 then st.u0 = v / st.s0 end
    System.__properties.__parried = false
    if System.__properties.__autoparry_enabled and not System.__triggerbot.__enabled
        and ball:GetAttribute("target") == LocalPlayer.Name then
        System.autoparry.process(ball, st.t0)
    end
end

function System.autoparry.step()
    local ap = System.autoparry
    local sys = System.__properties
    if not sys.__autoparry_enabled then return end
    local char = LocalPlayer.Character
    if not char or not char.PrimaryPart then return end
    local now = os.clock()
    ap.frame = ap.frame + (math.clamp(now - ap.last_step, 0.004, 0.1) - ap.frame) * 0.2
    ap.last_step = now
    ap.update_ping()
    if System.__triggerbot.__enabled or getgenv().BallVelocityAbove800 then return end
    local list = ap.list
    table.clear(list)
    local balls = Workspace:FindFirstChild("Balls")
    if balls then
        for _, b in ipairs(balls:GetChildren()) do
            if b:GetAttribute("realBall") then
                if b.CanCollide then b.CanCollide = false end
                list[#list + 1] = b
            end
        end
    end
    local training = Workspace:FindFirstChild("TrainingBalls")
    if training then
        for _, b in ipairs(training:GetChildren()) do
            if b:GetAttribute("realBall") then
                list[#list + 1] = b
                break
            end
        end
    end
    for i = 1, #list do
        ap.process(list[i], now)
    end
    for ball, st in pairs(ap.states) do
        if not ball.Parent then
            if st.conn then st.conn:Disconnect() end
            ap.states[ball] = nil
        end
    end
end

function System.autoparry.start()
    local conns = System.__properties.__connections
    if conns.__autoparry then conns.__autoparry:Disconnect() end
    System.autoparry.last_step = os.clock()
    conns.__autoparry = RunService.PreSimulation:Connect(System.autoparry.step)
end

function System.autoparry.stop()
    local conns = System.__properties.__connections
    if conns.__autoparry then
        conns.__autoparry:Disconnect()
        conns.__autoparry = nil
    end
    for ball, st in pairs(System.autoparry.states) do
        if st.conn then st.conn:Disconnect() end
        System.autoparry.states[ball] = nil
    end
end

