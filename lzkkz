    -- ===== PROTECAO DA ESPADA (e de qualquer item do jogo preso no personagem) =====
    -- No Blade Ball a espada e um Model filho do personagem, preso por uma junta numa
    -- parte do corpo. Ao reaplicar o avatar logo apos o respawn o corpo e mexido
    -- (ApplyDescription / troca de partes) e a espada pode perder a junta ou a
    -- animacao e aparecer no meio das pernas apontando pra cima. Antes de mexer a
    -- gente guarda como ela estava presa e, se algo quebrar, refaz igual.
    local GEAR_IGNORE = { ExtraHorns = true, KorbloxLeg = true }

    local function gearRoot(char, inst)
        local top = inst
        while top and top.Parent and top.Parent ~= char do
            top = top.Parent
        end
        if top and top.Parent == char and (top:IsA("Model") or top:IsA("Tool")) and not GEAR_IGNORE[top.Name] then
            return top
        end
        return nil
    end

    local function findGear(char)
        for _, o in ipairs(char:GetChildren()) do
            if (o:IsA("Model") or o:IsA("Tool")) and not GEAR_IGNORE[o.Name] then
                return o
            end
        end
        return nil
    end

    local function snapshotGear(char)
        local snap = { joints = {}, tracks = {} }
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
                local p0, p1 = d.Part0, d.Part1
                local g0 = p0 and gearRoot(char, p0)
                local g1 = p1 and gearRoot(char, p1)
                -- so interessa a junta que liga o item ao corpo (uma ponta em cada lado)
                if (g0 or g1) and not (g0 and g1) then
                    local gearIs0 = g0 ~= nil
                    local bodyPart = gearIs0 and p1 or p0
                    local isJoint = d:IsA("JointInstance")
                    table.insert(snap.joints, {
                        inst = d,
                        class = d.ClassName,
                        name = d.Name,
                        parent = d.Parent,
                        parentIsLimb = d.Parent ~= nil and d.Parent.Parent == char,
                        parentName = d.Parent and d.Parent.Name or nil,
                        gearIs0 = gearIs0,
                        gearPart = gearIs0 and p0 or p1,
                        bodyPart = bodyPart,
                        bodyName = bodyPart and bodyPart.Name or nil,
                        c0 = isJoint and d.C0 or nil,
                        c1 = isJoint and d.C1 or nil,
                    })
                end
            end
        end

        local hum = char:FindFirstChildOfClass("Humanoid")
        local animator = hum and hum:FindFirstChildOfClass("Animator")
        local animate = char:FindFirstChild("Animate")
        if animator then
            for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                local okInfo, own = pcall(function()
                    local a = t.Animation
                    local fromAnimate = animate ~= nil and a ~= nil and a:IsDescendantOf(animate)
                    return t.Looped and not fromAnimate and t ~= emoteTrack
                end)
                if okInfo and own then
                    table.insert(snap.tracks, t)
                end
            end
        end
        return snap
    end

    local function restoreGear(char, snap)
        local fixedJoints, replayed = 0, 0
        for _, s in ipairs(snap.joints) do
            pcall(function()
                -- o item sumiu (o jogo desequipou/trocou): nao mexe
                if not s.gearPart or not s.gearPart:IsDescendantOf(char) then return end

                local body = s.bodyPart
                if not body or not body:IsDescendantOf(char) then
                    -- o membro foi trocado por outro: acha o novo pelo nome
                    body = s.bodyName and char:FindFirstChild(s.bodyName)
                    if not body or not body:IsA("BasePart") then return end
                end

                local want0 = s.gearIs0 and s.gearPart or body
                local want1 = s.gearIs0 and body or s.gearPart
                local j = s.inst

                if j.Parent == nil or not j:IsDescendantOf(char) then
                    -- a junta morreu junto com o membro antigo: recria igual
                    local nj = Instance.new(s.class)
                    nj.Name = s.name
                    nj.Part0 = want0
                    nj.Part1 = want1
                    if s.c0 then
                        nj.C0 = s.c0
                        nj.C1 = s.c1
                    end
                    local par = s.parent
                    if s.parentIsLimb then
                        par = char:FindFirstChild(s.parentName) or body
                    elseif not par or not par:IsDescendantOf(char) then
                        par = s.gearPart
                    end
                    nj.Parent = par
                    s.inst = nj
                    fixedJoints = fixedJoints + 1
                    return
                end

                -- junta viva: so corrige se alguma ponta ficou apontando pro membro antigo
                local changed = false
                if j.Part0 ~= want0 then
                    j.Part0 = want0
                    changed = true
                end
                if j.Part1 ~= want1 then
                    j.Part1 = want1
                    changed = true
                end
                if changed then
                    fixedJoints = fixedJoints + 1
                end
            end)
        end

        for _, t in ipairs(snap.tracks) do
            pcall(function()
                if not t.IsPlaying then
                    t:Play(0.1)
                    replayed = replayed + 1
                end
            end)
        end

        if fixedJoints > 0 or replayed > 0 then
            warn("[Avatar] item do jogo (espada) restaurado: " .. fixedJoints .. " junta(s), " .. replayed .. " animacao(oes)")
        end
    end

    local function loadSkinNow(char, hum, token)
