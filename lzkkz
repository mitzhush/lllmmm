    local function serializeDesc(desc)
        local out = { n = {}, c = {}, s = {}, sc = {}, acc = {}, em = {}, eq = {} }
        for _, k in ipairs(NUM_KEYS) do
            local ok, v = pcall(function() return desc[k] end)
            if ok and type(v) == "number" and v ~= 0 then
                out.n[k] = fmtId(v)
            end
        end
        for _, k in ipairs(COLOR_KEYS) do
            local ok, v = pcall(function() return desc[k] end)
            if ok and typeof(v) == "Color3" then
                out.c[k] = { v.R, v.G, v.B }
            end
        end
        for _, k in ipairs(ACCESSORY_KEYS) do
            local ok, v = pcall(function() return desc[k] end)
            if ok and type(v) == "string" and v ~= "" then
                out.s[k] = v
            end
        end
        for i, def in ipairs(SCALE_DEFS) do
            out.sc[def.desc] = scales[i]
        end
        local okAcc, accs = pcall(function() return desc:GetAccessories(true) end)
        if okAcc and type(accs) == "table" then
            for _, a in ipairs(accs) do
                local okT, tname = pcall(function() return a.AccessoryType.Name end)
                if okT and tname and tonumber(a.AssetId) then
                    local e = { id = fmtId(a.AssetId), t = tname, l = a.IsLayered and true or false }
                    if type(a.Order) == "number" then e.o = a.Order end
                    if type(a.Puffiness) == "number" then e.p = a.Puffiness end
                    e.pos = vecToTable(a.Position)
                    e.rot = vecToTable(a.Rotation)
                    e.scl = vecToTable(a.Scale)
                    table.insert(out.acc, e)
                end
            end
        end
        local okEm, all = pcall(function() return desc:GetEmotes() end)
        if okEm and type(all) == "table" then
            for name, ids in pairs(all) do
                if type(ids) == "table" then
                    local arr = {}
                    for _, id in ipairs(ids) do
                        table.insert(arr, fmtId(id))
                    end
                    if #arr > 0 then out.em[name] = arr end
                end
            end
        end
        local okEq, equipped = pcall(function() return desc:GetEquippedEmotes() end)
        if okEq and type(equipped) == "table" then
            for _, e in ipairs(equipped) do
                if e.Name and e.Slot then
                    table.insert(out.eq, { Slot = e.Slot, Name = e.Name })
                end
            end
        end
        return out
    end

    local function deserializeDesc(data)
        local desc = Instance.new("HumanoidDescription")
        for k, v in pairs(data.n or {}) do
            local n = tonumber(v)
            if n then pcall(function() desc[k] = n end) end
        end
        for k, c in pairs(data.c or {}) do
            if type(c) == "table" and tonumber(c[1]) and tonumber(c[2]) and tonumber(c[3]) then
                pcall(function() desc[k] = Color3.new(tonumber(c[1]), tonumber(c[2]), tonumber(c[3])) end)
            end
        end
        for k, v in pairs(data.s or {}) do
            if type(v) == "string" then pcall(function() desc[k] = v end) end
        end
        for k, v in pairs(data.sc or {}) do
            local n = tonumber(v)
            if n then pcall(function() desc[k] = n end) end
        end
        local list = {}
        for _, e in ipairs(data.acc or {}) do
            local okT, accType = pcall(function() return Enum.AccessoryType[e.t] end)
            local id = tonumber(e.id)
            if okT and accType and id then
                local entry = { AssetId = id, AccessoryType = accType, IsLayered = e.l and true or false }
                if tonumber(e.o) then entry.Order = tonumber(e.o) end
                if tonumber(e.p) then entry.Puffiness = tonumber(e.p) end
                local pos = tableToVec(e.pos)
                local rot = tableToVec(e.rot)
                local scl = tableToVec(e.scl)
                if pos then entry.Position = pos end
                if rot then entry.Rotation = rot end
                if scl then entry.Scale = scl end
                table.insert(list, entry)
            end
        end
        if #list > 0 then
            pcall(function() desc:SetAccessories(list, true) end)
        end
        local em = {}
        for name, ids in pairs(data.em or {}) do
            local arr = {}
            if type(ids) == "table" then
                for _, id in ipairs(ids) do
                    local n = tonumber(id)
                    if n then table.insert(arr, n) end
                end
            end
            if #arr > 0 then em[name] = arr end
        end
        pcall(function() desc:SetEmotes(em) end)
        local eq = {}
        for _, e in ipairs(data.eq or {}) do
            if type(e) == "table" and e.Name and tonumber(e.Slot) then
                table.insert(eq, { Slot = tonumber(e.Slot), Name = e.Name })
            end
        end
        pcall(function() desc:SetEquippedEmotes(eq) end)
        return desc
    end

