        "HatAccessory", "HairAccessory", "FaceAccessory", "NeckAccessory",
        "ShouldersAccessory", "FrontAccessory", "BackAccessory", "WaistAccessory",
    }

    local function collectAccessoryIds(desc)
        local ids, seen = {}, {}
        local function add(id)
            id = tonumber(id)
            if id and id > 0 and not seen[id] then
                seen[id] = true
                table.insert(ids, id)
            end
        end
        local ok, accs = pcall(function() return desc:GetAccessories(true) end)
        if ok and accs then
            for _, a in ipairs(accs) do
                add(a.AssetId)
            end
        end
        for _, key in ipairs(ACCESSORY_KEYS) do
            local okKey, value = pcall(function() return desc[key] end)
            if okKey and type(value) == "string" then
                for id in string.gmatch(value, "%d+") do
                    add(id)
                end
            end
        end
        return ids
    end

    local function applyBodyPart(char, id)
        local objs = loadAsset(id)
        if not objs then return end
        for _, cm in ipairs(findAll(objs, "CharacterMesh")) do
            for _, old in ipairs(char:GetChildren()) do
                if old:IsA("CharacterMesh") and old.BodyPart == cm.BodyPart then
                    old:Destroy()
                end
            end
            pcall(function() cm:Clone().Parent = char end)
        end
        for _, mp in ipairs(findAll(objs, "MeshPart")) do
            local target = char:FindFirstChild(mp.Name)
            if target and target:IsA("BasePart") then
                pcall(function()
                    if target:IsA("MeshPart") then
                        target.MeshId = mp.MeshId
                        target.TextureID = mp.TextureID
                        for _, old in ipairs(target:GetChildren()) do
                            if old:IsA("SurfaceAppearance") then old:Destroy() end
                        end
                        local sa = mp:FindFirstChildWhichIsA("SurfaceAppearance")
                        if sa then sa:Clone().Parent = target end
                    else
                        local sm = target:FindFirstChildWhichIsA("SpecialMesh")
                        if not sm then
                            sm = Instance.new("SpecialMesh")
                            sm.Parent = target
                        end
                        sm.MeshType = Enum.MeshType.FileMesh
                        sm.MeshId = mp.MeshId
                        sm.TextureId = mp.TextureID
                    end
                end)
            end
        end
        for _, sm in ipairs(findAll(objs, "SpecialMesh")) do
            local partName = sm.Parent and sm.Parent.Name
            local target = partName and char:FindFirstChild(partName)
            if target and target:IsA("BasePart") and not target:IsA("MeshPart") then
                pcall(function()
                    local mesh = target:FindFirstChildWhichIsA("SpecialMesh")
                    if not mesh then
                        mesh = Instance.new("SpecialMesh")
                        mesh.Parent = target
                    end
                    mesh.MeshType = Enum.MeshType.FileMesh
                    mesh.MeshId = sm.MeshId
                    mesh.TextureId = sm.TextureId
                    mesh.Scale = sm.Scale
                end)
            end
        end
    end

