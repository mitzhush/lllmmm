    local function swapPart(char, newPart)
        local old = char:FindFirstChild(newPart.Name)
        if not old or not old:IsA("BasePart") then return nil end
        local savedCFrame = old.CFrame
        pcall(function() old.Size = newPart.Size end)
        if old:IsA("MeshPart") and newPart:IsA("MeshPart") then
            pcall(function() old.MeshId = newPart.MeshId end)
            pcall(function() old.TextureID = newPart.TextureID end)
            for _, d in ipairs(old:GetChildren()) do
                if d:IsA("SurfaceAppearance") then
                    d:Destroy()
                end
            end
            local sa = newPart:FindFirstChildWhichIsA("SurfaceAppearance")
            if sa then
                pcall(function() sa:Clone().Parent = old end)
            end
        elseif not old:IsA("MeshPart") then
            local newMesh = newPart:FindFirstChildWhichIsA("SpecialMesh")
            if newMesh then
                local oldMesh = old:FindFirstChildWhichIsA("SpecialMesh")
                if not oldMesh then
                    oldMesh = Instance.new("SpecialMesh")
                    oldMesh.Parent = old
                end
                pcall(function()
                    oldMesh.MeshType = newMesh.MeshType
                    oldMesh.MeshId = newMesh.MeshId
                    oldMesh.TextureId = newMesh.TextureId
                    oldMesh.Scale = newMesh.Scale
                    oldMesh.Offset = newMesh.Offset
                end)
            end
        end
        for _, att in ipairs(newPart:GetChildren()) do
            if att:IsA("Attachment") then
                local target = old:FindFirstChild(att.Name)
                if target and target:IsA("Attachment") then
                    target.CFrame = att.CFrame
                end
            end
        end
        return old, savedCFrame
    end

    local function ensureAttached(char, list)
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return 0 end
        task.wait()
        local fixed = 0
        local rootAssembly = root.AssemblyRootPart
        for _, item in ipairs(list) do
            local part = item.part
            if part.Parent and part.AssemblyRootPart ~= rootAssembly then
                local weld = Instance.new("Weld")
                weld.Name = "AvatarToolFallbackWeld"
                weld.Part0 = root
                weld.Part1 = part
                weld.C0 = root.CFrame:ToObjectSpace(item.cframe)
                weld.C1 = CFrame.new()
                weld.Parent = part
                part.CFrame = item.cframe
                fixed = fixed + 1
            end
        end
        return fixed
    end

    local function countAccessories(container)
        local n = 0
        for _, o in ipairs(container:GetChildren()) do
            if o:IsA("Accoutrement") then
                n = n + 1
            end
        end
        return n
    end

    local function lookMatches(char, model)
        local compared = 0
        for _, mp in ipairs(model:GetChildren()) do
            if mp:IsA("MeshPart") then
                local cp = char:FindFirstChild(mp.Name)
                if not cp or not cp:IsA("MeshPart") then return false end
                compared = compared + 1
                if cp.MeshId ~= mp.MeshId then return false end
            elseif mp:IsA("BasePart") and mp.Name == "Head" then
                local cp = char:FindFirstChild("Head")
                local ms = mp:FindFirstChildWhichIsA("SpecialMesh")
                local cs = cp and cp:FindFirstChildWhichIsA("SpecialMesh")
                if not ms or not cs then return false end
                compared = compared + 1
                if cs.MeshId ~= ms.MeshId then return false end
            end
        end
        if compared == 0 then return false end
        if countAccessories(char) ~= countAccessories(model) then return false end
        local cShirt = char:FindFirstChildOfClass("Shirt")
        local mShirt = model:FindFirstChildOfClass("Shirt")
        if (cShirt and cShirt.ShirtTemplate) ~= (mShirt and mShirt.ShirtTemplate) then return false end
        return true
    end

    local function syncJoints(char, model)
        for _, mj in ipairs(model:GetDescendants()) do
            if mj:IsA("Motor6D") and mj.Part1 then
                for _, cj in ipairs(char:GetDescendants()) do
                    if cj:IsA("Motor6D") and cj.Name == mj.Name and cj.Part1 and cj.Part1.Name == mj.Part1.Name then
                        cj.C0 = mj.C0
                        cj.C1 = mj.C1
                    end
                end
            end
        end
    end

    local function bodySignature(container)
        local total = 0
        for _, o in ipairs(container:GetChildren()) do
            if o:IsA("BasePart") and o.Name ~= "HumanoidRootPart" then
                total = total + o.Size.Magnitude
            end
        end
        return total
    end

    local function swapBodyParts(char, hum, model)
        local prevNeck = hum.RequiresNeck
        pcall(function() hum.RequiresNeck = false end)
        local newParts = {}
        for _, part in ipairs(model:GetChildren()) do
            if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
                local ok, np, cf = pcall(swapPart, char, part)
                if not ok then
                    warn("[Skin] swap " .. part.Name .. ": " .. tostring(np))
                elseif np then
                    table.insert(newParts, { part = np, cframe = cf })
                end
            end
        end
        pcall(syncJoints, char, model)
        local okFix, fixed = pcall(ensureAttached, char, newParts)
        if okFix and fixed and fixed > 0 then
            warn("[Skin] " .. tostring(fixed) .. " peca(s) soldadas no HumanoidRootPart (joint nao conectou)")
        end
        pcall(function() hum.RequiresNeck = prevNeck end)
        pcall(function()
            local modelHum = model:FindFirstChildOfClass("Humanoid")
            if modelHum and modelHum.HipHeight > 0 and hum.RigType == Enum.HumanoidRigType.R15 then
                hum.HipHeight = modelHum.HipHeight
            end
        end)
        return #newParts
    end

    local function forceBodyScale(char, hum)
        local source = copyState.desc or originalDesc
        if not source or hum.RigType ~= Enum.HumanoidRigType.R15 then return false end
        local model = buildModel(hum, source)
        if not model then return false end
        swapBodyParts(char, hum, model)
        pcall(function() model:Destroy() end)
        return true
    end

    local function rebuildFromModel(char, hum, desc, nativeOk)
        local model = buildModel(hum, desc)
        if not model then return false end
        local isR15 = hum.RigType == Enum.HumanoidRigType.R15

        if nativeOk and lookMatches(char, model) then
            local total = countAccessories(model)
            if isR15 then
                writeScales(hum, scales)
                task.wait(0.3)
                local sigModel = bodySignature(model)
                local sigChar = bodySignature(char)
                if sigModel > 0 and math.abs(sigChar - sigModel) / sigModel > 0.03 then
                    swapBodyParts(char, hum, model)
                end
            end
            pcall(function() model:Destroy() end)
            return total, total
        end

        if isR15 then
            writeScales(hum, scales)
            task.wait(0.3)
        end

        swapBodyParts(char, hum, model)

        pcall(function()
            local modelColors = model:FindFirstChildOfClass("BodyColors")
            if modelColors then
                for _, old in ipairs(char:GetChildren()) do
                    if old:IsA("BodyColors") then
                        old:Destroy()
                    end
                end
                modelColors:Clone().Parent = char
            end
        end)

        for _, old in ipairs(char:GetChildren()) do
            if old:IsA("CharacterMesh") then
                old:Destroy()
            end
        end
        for _, obj in ipairs(model:GetChildren()) do
            if obj:IsA("CharacterMesh") or obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") then
                pcall(function() obj:Clone().Parent = char end)
            end
        end

        local added, total = 0, 0
        for _, acc in ipairs(model:GetChildren()) do
            if acc:IsA("Accoutrement") then
                total = total + 1
                local okAttach, res = pcall(attachAccessory, char, hum, acc)
                if okAttach and res then
                    added = added + 1
                end
            end
        end

        pcall(function() model:Destroy() end)

        if isR15 then
            task.wait(0.1)
            writeScales(hum, scales)
        end
        return added, total
    end

    local function applyCopiedDescriptionRaw(char, hum, desc, keepScales)
        clearAllAccessories(char)
        clearAllOutfit(char)
        if not keepScales then
            scalesFromDesc(desc)
            refreshSliders()
        end
        local nativeOk = false
        local okNative, nativeRes = pcall(applyDescriptionSafe, hum, desc)
        if okNative and nativeRes then nativeOk = true end
        local okModel, added, total = pcall(rebuildFromModel, char, hum, desc, nativeOk)
        if okModel and added then
            return added, total
        end
        local okCopy, a, t = pcall(manualCopy, char, hum, desc)
        pcall(writeScales, hum, scales)
        if okCopy then
            return a, t
        end
        return 0, 0
    end

