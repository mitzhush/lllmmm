local function x2(flag, kind, defaultVal, callback, ctrl)
    if not flag or flag == "" then return end
    u2[flag] = defaultVal
    p2[flag] = {
        kind = kind,
        callback = callback,
        control = ctrl
    }
end

local function q2(flag, newState)
    local entry = p2[flag]
    if not entry then return end
    local callbackFired = false
    entry._onSet = function()
        callbackFired = true
    end
    if entry.control then
        pcall(function()
            if entry.control.Set then
                entry.control:Set(newState)
            end
        end)
    end
    entry._onSet = nil
    if not callbackFired and entry.callback then
        pcall(entry.callback, newState)
    end
end

local function applyValue(obj, v)
    if type(obj) ~= "table" then return end
    for _, name in ipairs({"SetValue", "SetState", "Set", "SetSelected"}) do
        local fn = obj[name]
        if type(fn) == "function" then
            pcall(fn, v)
            return
        end
    end
end

local firstTab = true

function Window:AddTab(options)
    local page = lib:CreateTab(options.Title, firstTab, options.Icon)
    firstTab = false
    local tab = {}
    function tab:AddSection(title)
        pcall(function() lib:MakeSeparator(page, title) end)
        local section = {}
        function section:AddToggle(flag, cfg)
            local origCb = cfg.Callback
            local wrappedCb = function(v)
                if flag then
                    u2[flag] = v
                    local reg = p2[flag]
                    if reg and reg._onSet then reg._onSet() end
                end
                if origCb then origCb(v) end
            end
            local tg = lib:AddToggle(page, cfg.Title, wrappedCb, nil, flag and ("mithub." .. flag) or nil, KEYBIND_FLAGS[flag] and true or nil)
            if cfg.Default then
                pcall(function() tg.SetState(true, true) end)
            end
            local ctrl = {}
            function ctrl:Set(v)
                pcall(function() tg.SetState(v, true) end)
            end
            x2(flag, "toggle", cfg.Default or false, wrappedCb, ctrl)
            return ctrl
        end
        function section:AddDropdown(flag, cfg)
            local origCb = cfg.Callback
            local wrappedCb = function(v)
                if flag then u2[flag] = v end
                if origCb then origCb(v) end
            end
            local dd = lib:AddDropdown(page, cfg.Title, cfg.Values, cfg.Default, wrappedCb, flag and ("mithub." .. flag) or nil, true)
            local ctrl = {}
            function ctrl:Set(v) applyValue(dd, v) end
            x2(flag, "dropdown", cfg.Default, wrappedCb, ctrl)
            return ctrl
        end
        function section:AddSlider(flag, cfg)
            local origCb = cfg.Callback
            local wrappedCb = function(v)
                if flag then u2[flag] = v end
                if origCb then origCb(v) end
            end
            local sl = lib:MakeSlider(page, cfg.Title, cfg.Min, cfg.Max, cfg.Default, cfg.Rounding or 0, wrappedCb)
            local ctrl = {}
            function ctrl:Set(v) applyValue(sl, v) end
            x2(flag, "slider", cfg.Default, wrappedCb, ctrl)
            if flag then
                pcall(function()
                    lib:RegisterFlag("mithub." .. flag, function() return u2[flag] end, function(v)
                        if v == nil then return end
                        ctrl:Set(v)
                        wrappedCb(v)
                    end)
                end)
            end
            return ctrl
        end
        function section:AddInput(flag, cfg)
            local origCb = cfg.Callback
            local wrappedCb = function(v)
                if flag then u2[flag] = v end
                if origCb then origCb(v) end
            end
            local row = lib:MakeRow(page, 34)
            lib:MakeLabel(row, cfg.Title, 10, 120)
            local box = lib:MakeTextBox(row, tostring(cfg.Default or ""), cfg.Placeholder or "", -150, 140)
            box.FocusLost:Connect(function()
                wrappedCb(box.Text)
            end)
            local ctrl = {}
            function ctrl:Set(v) box.Text = tostring(v) end
            x2(flag, "input", cfg.Default or "", wrappedCb, ctrl)
            return ctrl
        end
        function section:AddValueBox(flag, cfg)
            local current = cfg.Default
            local row = lib:MakeRow(page, 34)
            lib:MakeLabel(row, cfg.Title, 10, 120)
            local box = lib:MakeTextBox(row, tostring(cfg.Default), cfg.Placeholder or "", -150, 140)
            local function commit(v)
                local n = tonumber(v)
                if not n then
                    box.Text = tostring(current)
                    return
                end
                if cfg.Min and n < cfg.Min then n = cfg.Min end
                if cfg.Max and n > cfg.Max then n = cfg.Max end
                if cfg.Rounding then
                    local m = 10 ^ cfg.Rounding
                    n = math.floor(n * m + 0.5) / m
                end
                current = n
                box.Text = tostring(n)
                if flag then u2[flag] = n end
                if cfg.Callback then cfg.Callback(n) end
            end
            box.FocusLost:Connect(function()
                commit(box.Text)
            end)
            local ctrl = {}
            function ctrl:Set(v) commit(v) end
            x2(flag, "input", cfg.Default, commit, ctrl)
            if flag then
                pcall(function()
                    lib:RegisterFlag("mithub." .. flag, function() return u2[flag] end, function(v)
                        if v == nil then return end
                        commit(v)
                    end)
                end)
            end
            pcall(commit, cfg.Default)
            return ctrl
        end
        function section:AddButton(_, cfg)
            return lib:AddButton(page, cfg.Title, cfg.Callback)
        end
        return section
    end
    return tab
end

