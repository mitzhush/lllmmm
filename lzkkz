                if token ~= loadToken or not copyState.desc then break end
                local okCheck, matches = pcall(appearanceOk, char, hum, copyState.desc)
                if not okCheck or matches then break end
                applyCopiedDescription(char, hum, copyState.desc, true)
                restoreGear(char, gear)
            end
            task.wait(0.5)
            restoreGear(char, gear)
        elseif scalesTouched then
            writeScales(hum, scales)
        end
        if token == loadToken then
            applyExtras()
        end
    end

