local z1 = {}
local function f1(instance, thickness, edge)
    edge = edge or Color3.fromRGB(160, 60, 255)
    local stroke = Instance.new("UIStroke")
    stroke.Thickness = thickness or 2
    stroke.Color = Color3.fromRGB(255, 255, 255)
    stroke.Transparency = 0.1
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = instance

    local gradient = Instance.new("UIGradient")
    gradient.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.0, edge),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
        ColorSequenceKeypoint.new(1.0, edge)
    })
    gradient.Rotation = 0
    gradient.Parent = stroke

    local conn
    conn = RunService.RenderStepped:Connect(function(dt)
        if not stroke.Parent then
            if conn then conn:Disconnect() end
            return
        end
        gradient.Rotation = (gradient.Rotation + dt * 95) % 360
    end)
    table.insert(z1, conn)
    return stroke, gradient
end

