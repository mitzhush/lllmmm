    local function attachmentFrames(head, handle, accessory)
        for _, att in ipairs(handle:GetChildren()) do
            if att:IsA("Attachment") then
                local headAtt = head:FindFirstChild(att.Name)
                if headAtt and headAtt:IsA("Attachment") then
                    return headAtt.CFrame, att.CFrame
                end
            end
        end
        local point = accessory and accessory.AttachmentPoint or CFrame.new()
        return CFrame.new(0, head.Size.Y / 2, 0), point
    end

    local function equipAttached(char, head, id, name, offset)
        local objs = loadAsset(id)
        if not objs then return false end
        local old = char:FindFirstChild(name)
        if old then old:Destroy() end

        local acc, handle
        for _, o in ipairs(objs) do
            if o:IsA("Accoutrement") then
                acc = o
            else
                acc = o:FindFirstChildWhichIsA("Accoutrement", true)
            end
            if acc then
                handle = acc:FindFirstChild("Handle")
                break
            end
        end
        if not handle then
            for _, o in ipairs(objs) do
                if o:IsA("BasePart") then
                    handle = o
                else
                    handle = o:FindFirstChild("Handle", true) or o:FindFirstChildWhichIsA("BasePart", true)
                end
                if handle then break end
            end
        end

        local ok = false
        if handle and handle:IsA("BasePart") then
            local c0, c1 = attachmentFrames(head, handle, acc)
            local part = handle:Clone()
            part.Name = name
            part.CanCollide = false
            part.Anchored = false
            part.Massless = true
            for _, d in ipairs(part:GetChildren()) do
                if d:IsA("JointInstance") or d:IsA("WeldConstraint") then
                    d:Destroy()
                end
            end
            part.CFrame = head.CFrame * c0 * c1:Inverse()
            local weld = Instance.new("Weld")
            weld.Name = "ExtraWeld"
            weld.Part0 = head
            weld.Part1 = part
            weld.C0 = c0 * CFrame.new(offset or Vector3.zero)
            weld.C1 = c1
            weld.Parent = part
            part.Parent = char
            ok = true
        end

        for _, o in ipairs(objs) do
            pcall(function() o:Destroy() end)
        end
        return ok
    end

    local function overlayKorblox(char, side)
        local r15Part = char:FindFirstChild(KORBLOX_TARGETS[side])
        local r6Part = char:FindFirstChild(KORBLOX_FALLBACK[side])
        local targetPart = r15Part or r6Part
        if not targetPart then return false end
        local anchorCFrame = r15Part and r15Part.CFrame or (r6Part.CFrame * CFrame.new(0, R6_LEG_LIFT, 0))
        local objs = loadAsset(KORBLOX_IDS[side])
        if not objs or #objs == 0 then return false end
        local assetModel = objs[1]
        local mainMesh = assetModel:IsA("BasePart") and assetModel or assetModel:FindFirstChildWhichIsA("BasePart", true)
        if not mainMesh then return false end
        for _, partName in ipairs(KORBLOX_HIDES[side]) do
            local limb = char:FindFirstChild(partName)
            if limb and limb:IsA("BasePart") then
                limb.Transparency = 1
            end
        end
        mainMesh.CanCollide = false
        mainMesh.Massless = true
        mainMesh.CFrame = anchorCFrame
        local weld = Instance.new("WeldConstraint")
        weld.Part0 = targetPart
        weld.Part1 = mainMesh
        weld.Parent = mainMesh
        assetModel.Name = "KorbloxLeg"
        assetModel.Parent = char
        return true
    end

