System.autoparry = {
    config = {ping_comp = 1, extra_lead = 0, floor = 0.5},
    states = {},
    list = {},
    ping = 0.05,
    jitter = 0.004,
    frame = 1 / 60,
    last_step = os.clock(),
    ping_ready = false
}

function System.autoparry.update_ping()
    local ap = System.autoparry
    if not ap.ping_item then
        local ok, item = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"] end)
        if not ok or not item then return end
        ap.ping_item = item
    end
    local raw = ap.ping_item:GetValue() / 1000
    if raw ~= raw or raw < 0 or raw > 5 then return end
    if not ap.ping_ready then
        ap.ping = raw
        ap.ping_ready = true
        return
    end
    local diff = math.abs(raw - ap.ping)
    ap.ping = ap.ping + (raw - ap.ping) * 0.2
    ap.jitter = ap.jitter + (diff - ap.jitter) * 0.2
end

function System.autoparry.get_lead()
    local ap = System.autoparry
    local cfg = ap.config
    local base = math.clamp(0.27 / System.__properties.__divisor_multiplier, 0.12, 0.45)
    local net = (ap.ping + ap.jitter) * cfg.ping_comp
    return math.clamp(base + net + ap.frame + 0.015 + cfg.extra_lead / 1000, 0.05, 0.9)
end

function System.autoparry.track(ball, zoomies, now)
    local ap = System.autoparry
    local vel = zoomies.VectorVelocity
    if vel.Magnitude < 0.01 then vel = ball.AssemblyLinearVelocity end
    local speed = vel.Magnitude
    local st = ap.states[ball]
    if not st then
        st = {
            t0 = now,
            s0 = speed,
            u0 = speed > 1 and vel / speed or Vector3.new(0, 0, 1),
            omega = 0,
            accel = 0,
            settle = 0,
            fired = false,
            fired_at = 0
        }
        st.conn = ball:GetAttributeChangedSignal("target"):Connect(function()
            System.autoparry.on_target(ball, st)
        end)
        ap.states[ball] = st
        return st, vel, speed
    end
    local elapsed = now - st.t0
    if elapsed >= 0.08 then
        if st.settle > 0 then
            st.settle = st.settle - 1
        elseif speed > 1 and st.s0 > 1 then
            local d = math.clamp(st.u0:Dot(vel / speed), -1, 1)
            st.omega = st.omega * 0.5 + math.min(math.acos(d) / elapsed, 30) * 0.5
            st.accel = st.accel * 0.5 + math.clamp((speed - st.s0) / elapsed, 0, 2500) * 0.5
        end
        st.t0 = now
        st.s0 = speed
        if speed > 1 then st.u0 = vel / speed end
    end
    return st, vel, speed
end

function System.autoparry.simulate(ball_pos, dir, speed, accel, my_pos, my_vel, omega, horizon, radius)
    local h = 1 / 60
    local steps = math.min(math.ceil(horizon / h), 54)
    local pos, me, d, s, t = ball_pos, my_pos, dir, speed, 0
    for _ = 1, steps do
        local to = me - pos
        local dm = to.Magnitude
        if dm <= radius + s * h * 0.5 then return t end
        local want = to / dm
        local ang = math.acos(math.clamp(d:Dot(want), -1, 1))
        local turn = omega * h
        if ang <= turn then
            d = want
        else
            local nd = d + (want - d) * (turn / ang)
            if nd.Magnitude > 1e-4 then d = nd.Unit end
        end
        s = s + accel * h
        pos = pos + d * (s * h)
        me = me + my_vel * h
        t = t + h
    end
    return math.huge
end

function System.autoparry.should_fire(ball, st, vel, speed, root)
    local ap = System.autoparry
    local cfg = ap.config
    local my_pos = root.Position
    local my_vel = root.AssemblyLinearVelocity
    local my_speed = my_vel.Magnitude
    if my_speed > 120 then
        my_vel = my_vel * (120 / my_speed)
        my_speed = 120
    end
    local rel = ball.Position - my_pos
    local dist = rel.Magnitude
    if dist <= 14.5 then return true end
    local lead = ap.get_lead()
    local radius = 3.5
    local dir = speed > 1 and vel / speed or -rel / dist
    local eff_speed = speed + st.accel * 0.5 * lead
    local t_bound = (dist - radius) / math.max(eff_speed + my_speed, 1)
    if t_bound > lead then return false end
    local rel_v = dir * eff_speed - my_vel
    local a = rel_v:Dot(rel_v)
    local b = 2 * rel:Dot(rel_v)
    local c = dist * dist - radius * radius
    if a > 1e-6 and b < 0 then
        local disc = b * b - 4 * a * c
        if disc >= 0 and (-b - math.sqrt(disc)) / (2 * a) <= lead then return true end
    end
    local omega = math.clamp(st.omega * 1.2, 2.5, 16)
    if ap.simulate(ball.Position, dir, speed, st.accel, my_pos, my_vel, omega, lead, radius) <= lead then return true end
    local ratio = cfg.floor
    if dir:Dot(-rel / dist) < 0.34 then ratio = ratio * 0.45 end
    return t_bound <= lead * ratio
end

function System.autoparry.try_ability()
