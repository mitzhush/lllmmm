        local clone = acc:Clone()
        local cloneHandle = clone:FindFirstChild("Handle")
        if cloneHandle then
            for _, j in ipairs(cloneHandle:GetChildren()) do
                if j:IsA("JointInstance") or j:IsA("WeldConstraint") then
                    j:Destroy()
                end
            end
        end
        local ok = pcall(function() hum:AddAccessory(clone) end)
        if not ok or clone.Parent ~= char then
            clone.Parent = char
        end
        local handle = clone:FindFirstChild("Handle")
        if not handle or not handle:IsA("BasePart") then return true end
        task.wait()
        if handle:FindFirstChild("AccessoryWeld") then return true end
        local joint = handle:FindFirstChildWhichIsA("JointInstance")
        if joint then return true end
        local head = char:FindFirstChild("Head")
        local part0, c0, c1
        for _, att in ipairs(handle:GetChildren()) do
            if att:IsA("Attachment") then
                for _, bodyPart in ipairs(char:GetChildren()) do
                    if bodyPart:IsA("BasePart") then
                        local ca = bodyPart:FindFirstChild(att.Name)
                        if ca and ca:IsA("Attachment") then
                            part0, c0, c1 = bodyPart, ca.CFrame, att.CFrame
                            break
                        end
                    end
                end
            end
            if part0 then break end
        end
        if not part0 and head then
            part0 = head
            c0 = CFrame.new(0, head.Size.Y / 2, 0)
            c1 = clone.AttachmentPoint
        end
        if not part0 then return false end
        handle.Anchored = false
        handle.CanCollide = false
        handle.Massless = true
        local weld = Instance.new("Weld")
        weld.Name = "AccessoryWeld"
        weld.Part0 = part0
        weld.Part1 = handle
        weld.C0 = c0
        weld.C1 = c1
        weld.Parent = handle
        handle.CFrame = part0.CFrame * c0 * c1:Inverse()
        return true
    end

    local function manualCopy(char, hum, desc)
        local bc = char:FindFirstChildOfClass("BodyColors")
        if not bc then
            bc = Instance.new("BodyColors")
            bc.Parent = char
        end
        pcall(function()
            bc.HeadColor3 = desc.HeadColor
            bc.TorsoColor3 = desc.TorsoColor
            bc.LeftArmColor3 = desc.LeftArmColor
            bc.RightArmColor3 = desc.RightArmColor
            bc.LeftLegColor3 = desc.LeftLegColor
            bc.RightLegColor3 = desc.RightLegColor
        end)

        local function equipClothing(id)
            if not id or id == 0 then return end
            local objs = loadAsset(id)
            if not objs then return end
            for _, className in ipairs({"Shirt", "Pants", "ShirtGraphic"}) do
                for _, o in ipairs(findAll(objs, className)) do
                    pcall(function() o:Clone().Parent = char end)
                end
            end
            for _, o in ipairs(objs) do
                pcall(function() o:Destroy() end)
            end
        end

        pcall(function()
            clearAllOutfit(char)
            equipClothing(desc.Shirt)
            equipClothing(desc.Pants)
            equipClothing(desc.GraphicTShirt)
        end)

        pcall(function()
            for _, old in ipairs(char:GetChildren()) do
                if old:IsA("CharacterMesh") then
                    old:Destroy()
                end
            end
            for _, key in ipairs(BODY_PART_KEYS) do
                local id = desc[key]
                if id and id ~= 0 then
                    pcall(applyBodyPart, char, id)
                end
            end
        end)

        pcall(function()
            local head = char:FindFirstChild("Head")
            if head and desc.Face and desc.Face ~= 0 then
                local objs = loadAsset(desc.Face)
                if objs then
                    for _, o in ipairs(findAll(objs, "Decal")) do
                        local face = head:FindFirstChild("face") or head:FindFirstChildWhichIsA("Decal")
                        if face then
                            pcall(function() face.Texture = o.Texture end)
                        end
                    end
                    for _, o in ipairs(objs) do
                        pcall(function() o:Destroy() end)
                    end
                end
            end
        end)

        clearAllAccessories(char)
        local ids = collectAccessoryIds(desc)
        local added = 0
        for _, id in ipairs(ids) do
            local objs = loadAsset(id)
            if objs then
                local found = false
                for _, acc in ipairs(findAll(objs, "Accoutrement")) do
                    local okAttach, res = pcall(attachAccessory, char, hum, acc)
                    if okAttach and res then
                        found = true
                    end
                end
                if found then added = added + 1 end
                for _, o in ipairs(objs) do
                    pcall(function() o:Destroy() end)
                end
            end
        end
        return added, #ids
    end

    local function buildModel(hum, desc)
        local base = desc:Clone()
        for i, def in ipairs(SCALE_DEFS) do
