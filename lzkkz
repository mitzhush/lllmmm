    local function restoreIdentity()
        if not originalIdentity then return end
        local okId = pcall(function() LP.UserId = originalIdentity.userId end)
        if not okId and type(sethiddenproperty) == "function" then
            pcall(sethiddenproperty, LP, "UserId", originalIdentity.userId)
        end
        pcall(function() LP.Name = originalIdentity.name end)
        originalIdentity = nil
