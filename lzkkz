    local function revertCopy()
        if not copyState.desc then return "Nothing to undo" end
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return "No character" end
        if not originalDesc then return "No original saved" end

        copyState.desc = nil
        copyState.userId = nil
        copyState.name = nil
        copyState.emotes = {}

        stopEmote()
        clearAllAccessories(char)
        clearAllOutfit(char)
        for _, old in ipairs(char:GetChildren()) do
            if old:IsA("CharacterMesh") then
                old:Destroy()
            end
        end
        applyCopiedDescription(char, hum, originalDesc)
        restoreAnimations(char)
        restoreIdentity()
        scalesTouched = false
        applyExtras()
        return "Copy undone"
    end

    local function copyPlayer(text)
        local char = LP.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return "No character" end

        local userId = resolveUserId(text)
        if not userId then return "Player not found" end

        local desc = fetchDescription(userId)
        if not desc then return "Could not load avatar" end

        captureOriginal(hum)

        local okName, fetched = pcall(function()
            return Players:GetNameFromUserIdAsync(userId)
        end)
        local personName
        if okName and type(fetched) == "string" and fetched ~= "" then
            personName = fetched
        else
            local typed = trim(text)
            personName = tonumber(typed) and tostring(userId) or typed
        end

        stopEmote()
        copyState.desc = desc
        copyState.userId = userId
        copyState.name = personName
        copyState.emotes = collectEmotes(desc)

        applyCopiedDescription(char, hum, desc)
        pcall(applyCopiedAnimations, char, desc, userId)
        if copyIdentity then
            setIdentity(userId, personName)
        end
        applyExtras()

        return "Copied: " .. personName
    end

